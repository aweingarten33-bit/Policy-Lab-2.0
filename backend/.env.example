# ── LLM Provider API Keys ──
# Set at least one. The cascade tries configured providers in application order.
ANTHROPIC_API_KEY=      # console.anthropic.com — paid, primary when configured
OPENAI_API_KEY=         # platform.openai.com — paid fallback
GROQ_API_KEY=           # console.groq.com — fallback
GEMINI_API_KEY=         # aistudio.google.com — fallback
MISTRAL_API_KEY=        # console.mistral.ai — fallback
OPENROUTER_API_KEY=     # openrouter.ai — fallback

# ── API Security ──
# In production API_KEY is required; the application fails closed if it is
# missing. Administrative knowledge-base writes require a separate key.
API_KEY=
ADMIN_API_KEY=

# Trust X-Forwarded-For only when the deployment is behind a proxy that rewrites
# it. Set false for a directly exposed development server.
TRUST_PROXY=true

# Bound user-controlled text sent to paid model APIs.
MAX_INPUT_CHARS=100000

# ── CORS ──
# Comma-separated list of origins allowed to call the API.
# NEVER use "*" in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── App Settings ──
# "development" here on purpose. The production Docker image sets
# ENVIRONMENT=production and REQUIRE_GROUNDING=true explicitly.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Refuse generation when no authoritative source material was retrieved.
# Keep this true for production deployments of Policy Lab.
REQUIRE_GROUNDING=true

# ── Knowledge Base ──
# Mount a persistent volume and point this path at it when the runtime store
# must survive restarts. The production image also bakes a regulatory corpus.
KB_PERSIST_DIR=./knowledge_base
KB_AUTO_SEED=true
KB_ENABLED=true

# Runtime seeding is memory intensive and is disabled by default in application
# config. Prefer building the corpus into the image for production.
KB_SEED_AT_RUNTIME=false
KB_SEED_TIMEOUT_SECONDS=600
KB_EMBED_BATCH_SIZE=32

# ── Live Research ──
LIVE_RESEARCH_ENABLED=true
LIVE_RESEARCH_MAX_RESULTS=5
LIVE_RESEARCH_RAW_CONTENT=true
