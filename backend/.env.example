# ── LLM Provider API Keys ──
# Set at least one. The cascade tries all configured keys in order.
ANTHROPIC_API_KEY=      # console.anthropic.com — paid, primary: Claude Opus 4.8, best calibration/lowest hallucination rate
OPENAI_API_KEY=         # platform.openai.com — paid, fallback
GROQ_API_KEY=           # console.groq.com — free, fastest, fallback
GEMINI_API_KEY=         # aistudio.google.com — free tier, fallback
MISTRAL_API_KEY=        # console.mistral.ai — free tier, fallback
OPENROUTER_API_KEY=     # openrouter.ai — free models available, fallback

# ── API Security ──
# Optional. If set, all non-public endpoints require: x-api-key: <this value>
API_KEY=

# ── CORS ──
# Comma-separated list of origins allowed to call the API.
# NEVER use "*" in production: it lets any site on the internet call this API
# from a visitor's browser. The app is served from the same origin as the API,
# so production usually needs only its own URL.
# Example: https://policy-lab-2-0.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── App Settings ──
# "development" here on purpose: this file is copied for local work, and
# ENVIRONMENT=production changes real behaviour -- it makes missing auth fail
# closed and turns on HSTS. Set it to production only in the deployment.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ── Knowledge Base ──
# Railway provides a persistent volume — mount it at /data and set this path.
KB_PERSIST_DIR=./knowledge_base
KB_AUTO_SEED=true
KB_ENABLED=true

# ── Live Research ──
LIVE_RESEARCH_ENABLED=true
LIVE_RESEARCH_MAX_RESULTS=5
